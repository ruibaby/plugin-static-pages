{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --mode development --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path ../.gitignore",
    "prettier": "prettier --write src/",
    "type-check": "vue-tsc --build --force",
    "test:unit": "echo 'No unit tests'"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 100,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "@formkit/vue": "^2.1.2",
    "@halo-dev/api-client": "^2.26.0",
    "@halo-dev/components": "^2.26.0",
    "@halo-dev/ui-shared": "^2.26.0",
    "@he-tree/tree-utils": "0.1.0-alpha.4",
    "@he-tree/vue": "^2.10.5",
    "@imengyu/vue3-context-menu": "^1.5.6",
    "@tanstack/vue-query": "4.37.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "axios": "^1.13.5",
    "grapesjs": "^0.21.13",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "grapesjs-tabs": "^1.0.6",
    "monaco-editor": "^0.56.0",
    "pretty-bytes": "^7.1.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/vscode-icons": "^1.2.72",
    "@rushstack/eslint-patch": "^1.15.0",
    "@shikijs/markdown-it": "^4.4.3",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.33",
    "@unocss/eslint-config": "66.5.6",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "shiki": "^4.4.3",
    "typescript": "~5.8.3",
    "unocss": "66.5.6",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.29.2"
}
